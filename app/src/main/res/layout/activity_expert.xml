<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f0f2f5">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chat_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="8dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#d0d0d0" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp"
        android:background="#ffffff">

        <ImageButton
            android:id="@+id/btn_toggle_input"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.12"
            android:src="@drawable/avd_mic"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:background="@drawable/input_bg"
            android:contentDescription="切换输入模式" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.52"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/input_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="输入您的问题..."
                android:gravity="top"
                android:minHeight="44dp"
                android:maxLines="4"
                android:padding="8dp"
                android:textSize="15sp"
                android:background="@drawable/input_bg"
                android:inputType="text"
                android:visibility="visible" />

            <LinearLayout
                android:id="@+id/btn_hold_speak"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:background="@drawable/input_bg"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="按住"
                    android:textSize="15sp"
                    android:textColor="#666666" />

                <ImageView
                    android:id="@+id/img_mic_hold"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="4dp"
                    android:src="@drawable/avd_mic"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="说话"
                    android:textSize="15sp"
                    android:textColor="#666666" />

            </LinearLayout>

        </LinearLayout>

        <ImageButton
            android:id="@+id/btn_speaker"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.12"
            android:src="@drawable/ic_speaker_on"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:background="@drawable/input_bg"
            android:contentDescription="语音播报" />

        <TextView
            android:id="@+id/btn_unleash"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.12"
            android:gravity="center"
            android:text="严"
            android:textStyle="bold"
            android:textSize="15sp"
            android:textColor="#10b981"
            android:background="@drawable/input_bg"
            android:clickable="true"
            android:focusable="true" />

        <ImageButton
            android:id="@+id/btn_send"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.12"
            android:src="@drawable/ic_send"
            android:scaleType="centerInside"
            android:padding="6dp"
            android:background="@drawable/input_bg"
            android:contentDescription="发送" />

    </LinearLayout>

</LinearLayout>
