<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/tk_edit_table_w"
    android:layout_height="@dimen/tk_edit_row_h"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#FFFFFF">

    <Spinner
        android:id="@+id/sp_cat"
        android:layout_width="@dimen/tk_edit_cat"
        android:layout_height="@dimen/tk_edit_row_h"
        android:background="#F2F5F8"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:spinnerMode="dropdown" />

    <Spinner
        android:id="@+id/sp_name"
        android:layout_width="@dimen/tk_edit_name"
        android:layout_height="@dimen/tk_edit_row_h"
        android:background="#F2F5F8"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:spinnerMode="dropdown" />

    <TextView
        android:id="@+id/tv_spec"
        android:layout_width="@dimen/tk_edit_spec"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#5A6472"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tv_history"
        android:layout_width="@dimen/tk_edit_history"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#8A93A0"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/et_current"
        android:layout_width="@dimen/tk_edit_current"
        android:layout_height="match_parent"
        android:background="@drawable/bg_po_cell"
        android:gravity="center"
        android:hint="—"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:textColor="#1E2A3A"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_change"
        android:layout_width="@dimen/tk_edit_change"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#8A93A0"
        android:textSize="11sp" />

    <EditText
        android:id="@+id/et_qty"
        android:layout_width="@dimen/tk_edit_qty"
        android:layout_height="match_parent"
        android:background="@drawable/bg_po_cell"
        android:gravity="center"
        android:hint="—"
        android:importantForAutofill="no"
        android:inputType="numberDecimal"
        android:textColor="#1E2A3A"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tv_amount"
        android:layout_width="@dimen/tk_edit_amount"
        android:layout_height="match_parent"
        android:gravity="center"
        android:textColor="#1E2A3A"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_del"
        android:layout_width="@dimen/tk_edit_del"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="×"
        android:textColor="#C3CAD4"
        android:textSize="18sp" />
</LinearLayout>