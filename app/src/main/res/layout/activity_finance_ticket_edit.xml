<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#4CAF50"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:titleTextColor="#FFFFFF" />

    <!-- 单据抬头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/sp_supplier"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="#F2F5F8"
                android:spinnerMode="dropdown" />

            <TextView
                android:id="@+id/btn_manage_supplier"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_po_cell"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/finance_supplier_manage"
                android:textColor="#4CAF50"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_po_cell"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#1E2A3A"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/et_ticket_no"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_po_cell"
                android:gravity="center_vertical"
                android:hint="@string/finance_ticket_no"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#1E2A3A"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 第 1 个：付款账户（本公司账户）　第 2 个：已结算 / 未结算 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/sp_account"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="#F2F5F8"
                android:spinnerMode="dropdown" />

            <Spinner
                android:id="@+id/sp_settled"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="#F2F5F8"
                android:spinnerMode="dropdown" />
        </LinearLayout>
    </LinearLayout>

    <!-- 明细网格：八列横向，可左右滑动 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <HorizontalScrollView
                android:id="@+id/hsv_grid"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="@dimen/tk_edit_table_w"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- 表头：品类 / 品名 / 规格 / 历史价 / 当前价 / 涨跌幅 / 数量 / 金额 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="32dp"
                        android:background="#EEF2F6"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/PoEditHeadCell"
                            android:layout_width="@dimen/tk_edit_cat"
                            android:text="@string/finance_po_col_category" />

                        <TextView
                            style="@style/PoEditHeadCell"
                            android:layout_width="@dimen/tk_edit_name"
                            android:text="@string/finance_po_col_name" />

                        <TextView
                            style="@style/PoEditHeadCell"
                            android:layout_width="@dimen/tk_edit_spec"
                            android:text="@string/finance_po_col_spec" />

                        <TextView
                            style="@style/PoEditHeadCell"
                            android:layout_width="@dimen/tk_edit_history"
                            android:text="@string/finance_po_col_history" />

                        <TextView
                            style="@style/PoEditHeadCell"
                            android:layout_width="@dimen/tk_edit_current"
                            android:text="@string/finance_po_col_current" />

                        <TextView
                            style="@style/PoEditHeadCell"
                            android:layout_width="@dimen/tk_edit_change"
                            android:text="@string/finance_po_col_change" />

                        <TextView
                            style="@style/PoEditHeadCell"
                            android:layout_width="@dimen/tk_edit_qty"
                            android:text="@string/finance_po_col_qty" />

                        <TextView
                            style="@style/PoEditHeadCell"
                            android:layout_width="@dimen/tk_edit_amount"
                            android:text="@string/finance_po_col_amount" />

                        <View
                            android:layout_width="@dimen/tk_edit_del"
                            android:layout_height="1dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/ll_rows"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/tv_lines_empty"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:gravity="center"
                        android:text="@string/finance_po_no_lines"
                        android:textColor="#A8B0BB"
                        android:textSize="13sp"
                        android:visibility="gone" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 按需添加明细，不预置一堆空行 -->
            <Button
                android:id="@+id/btn_add_line"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_button_secondary"
                android:text="@string/finance_add"
                android:textColor="#4CAF50"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <!-- 单脚：行数 / 合计 / 备注 / 保存 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_line_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E53935"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <EditText
            android:id="@+id/et_remark"
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_po_cell"
            android:hint="@string/finance_remark"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#1E2A3A"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_button_green"
            android:text="@string/finance_save"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>