<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#f5f5f5">

    <!-- 系统栏留白：状态栏（深绿）。高度由 WindowInsets 驱动，系统已让位时为 0 -->
    <View
        android:id="@+id/status_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#1F6B30" />

    <!-- 顶部标题 - 左20%空白 + 中60%标题 + 右20%误差 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/title_height"
        android:orientation="horizontal"
        android:background="#2d8c42">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.2"
            android:gravity="start|center_vertical"
            android:paddingStart="8dp">

            <ImageView
                android:id="@+id/btn_column_settings"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center_vertical"
                android:src="@drawable/ic_settings"
                android:tint="#FFFFFF"
                android:scaleType="fitCenter"
                android:background="@null"
                android:contentDescription="@string/menu_settings"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.6"
            android:gravity="center"
            android:text="@string/title_mix_calculator"
            android:textSize="@dimen/title_text_size"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/tv_error_display"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.2"
            android:gravity="center"
            android:textSize="@dimen/title_text_size"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- 表格区域：表头 + 表体 + 表尾由同一个自绘 View 绘制 -->
    <com.shrimpfarm.app.mixcalc.table.MixCalcTableView
        android:id="@+id/mix_calc_table"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
    <!-- 系统栏留白：底部导航栏（白）。高度由 WindowInsets 驱动，系统已让位时为 0 -->
    <View
        android:id="@+id/nav_bar_spacer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#FFFFFF" />
</LinearLayout>

