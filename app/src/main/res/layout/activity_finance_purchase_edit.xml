<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#2196F3"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar" />

    <!-- 单据抬头 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/sp_supplier"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="#F2F5F8"
                android:spinnerMode="dropdown" />

            <TextView
                android:id="@+id/btn_manage_supplier_product"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_po_cell"
                android:gravity="center"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/finance_po_manage_goods"
                android:textColor="#2196F3"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/et_date"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:background="@drawable/bg_po_cell"
                android:gravity="center_vertical"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:textColor="#1E2A3A"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_order_no"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:gravity="center_vertical|end"
                android:textColor="#8A93A0"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 8 列可横向滚动的明细网格 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#FFFFFF">

        <HorizontalScrollView
            android:id="@+id/hsv_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="@dimen/po_edit_table_w"
                    android:layout_height="36dp"
                    android:background="#EEF2F6"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/PoEditHeadCell"
                        android:layout_width="@dimen/po_edit_cat"
                        android:text="@string/finance_po_col_category" />

                    <TextView
                        style="@style/PoEditHeadCell"
                        android:layout_width="@dimen/po_edit_name"
                        android:text="@string/finance_po_col_name" />

                    <TextView
                        style="@style/PoEditHeadCell"
                        android:layout_width="@dimen/po_edit_spec"
                        android:text="@string/finance_po_col_spec" />

                    <TextView
                        style="@style/PoEditHeadCell"
                        android:layout_width="@dimen/po_edit_history"
                        android:text="@string/finance_po_col_history" />

                    <TextView
                        style="@style/PoEditHeadCell"
                        android:layout_width="@dimen/po_edit_current"
                        android:text="@string/finance_po_col_current" />

                    <TextView
                        style="@style/PoEditHeadCell"
                        android:layout_width="@dimen/po_edit_change"
                        android:text="@string/finance_po_col_change" />

                    <TextView
                        style="@style/PoEditHeadCell"
                        android:layout_width="@dimen/po_edit_qty"
                        android:text="@string/finance_po_col_qty" />

                    <TextView
                        style="@style/PoEditHeadCell"
                        android:layout_width="@dimen/po_edit_amount"
                        android:text="@string/finance_po_col_amount" />

                    <TextView
                        style="@style/PoEditHeadCell"
                        android:layout_width="@dimen/po_edit_del" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_rows"
                    android:layout_width="@dimen/po_edit_table_w"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/tv_lines_empty"
                    android:layout_width="@dimen/po_edit_table_w"
                    android:layout_height="64dp"
                    android:gravity="center"
                    android:text="@string/finance_po_no_lines"
                    android:textColor="#A8B0BB"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>
        </HorizontalScrollView>
    </ScrollView>

    <!-- 单脚：合计 / 是否结账 / 付款账户 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#F7F9FB"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_line_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#666666"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E53935"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/sp_paid"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:spinnerMode="dropdown" />

            <Spinner
                android:id="@+id/sp_account"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:background="#FFFFFF"
                android:spinnerMode="dropdown" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:orientation="vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp">

        <EditText
            android:id="@+id/et_remark"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@drawable/bg_po_cell"
            android:hint="@string/finance_remark"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="#1E2A3A"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="#2196F3"
            android:text="@string/finance_save"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />
    </LinearLayout>
</LinearLayout>
