<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:elevation="10dp"
    android:minWidth="140dp">

    <!--
        行高由 MixCalcActivity.fitMenuRowHeights() 统一计算：首行 40dp，其余 39dp，
        加上 1dp 分隔线后行距正好 40dp，与表格行高对齐。
        系统字体放大时回缩字号而不是撑高行，保证分隔线始终落在表格横线网格上。
    -->
    <TextView
        android:id="@+id/menu_item_quick_settings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="40dp"
        android:includeFontPadding="false"
        android:text="@string/mix_menu_quick_settings"
        android:textSize="18sp"
        android:textColor="#333333"
        android:gravity="center"
        android:textAlignment="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="?attr/selectableItemBackground" />

    <View
        android:id="@+id/menu_divider_quick"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/menu_item_batch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="39dp"
        android:includeFontPadding="false"
        android:text="@string/mix_menu_batch"
        android:textSize="18sp"
        android:textColor="#333333"
        android:gravity="center"
        android:textAlignment="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />
    <TextView
        android:id="@+id/menu_item_privacy_policy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="39dp"
        android:includeFontPadding="false"
        android:text="@string/mix_menu_privacy_policy"
        android:textSize="18sp"
        android:textColor="#333333"
        android:gravity="center"
        android:textAlignment="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/menu_item_user_agreement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="39dp"
        android:includeFontPadding="false"
        android:text="@string/mix_menu_user_agreement"
        android:textSize="18sp"
        android:textColor="#333333"
        android:gravity="center"
        android:textAlignment="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/menu_item_help"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="39dp"
        android:includeFontPadding="false"
        android:text="@string/mix_menu_help"
        android:textSize="18sp"
        android:textColor="#333333"
        android:gravity="center"
        android:textAlignment="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/menu_item_language"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="39dp"
        android:includeFontPadding="false"
        android:text="@string/mix_menu_language"
        android:textSize="18sp"
        android:textColor="#333333"
        android:gravity="center"
        android:textAlignment="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/menu_item_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="39dp"
        android:includeFontPadding="false"
        android:textSize="18sp"
        android:textColor="#333333"
        android:gravity="center"
        android:textAlignment="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

</LinearLayout>
