<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:elevation="10dp"
    android:minWidth="140dp">

    <!--
        表格行高 40dp：弹窗顶部贴标题下沿（=表格顶），行距按 40dp 走，
        分隔线才能对齐表格横线（第 1 条 40、第 2 条 80、第 3 条 120）。
        分隔线本身 1dp，占掉下一行 1dp，故第 2~4 项行高写 39dp，行距仍是 40dp。
    -->
    <TextView
        android:id="@+id/menu_item_quick_settings"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/mix_menu_quick_settings"
        android:textSize="18sp"
        android:textColor="#333333"
        android:gravity="center"
        android:textAlignment="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="?attr/selectableItemBackground" />

    <View
        android:id="@+id/menu_divider_quick"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/menu_item_privacy_policy"
        android:layout_width="match_parent"
        android:layout_height="39dp"
        android:text="@string/mix_menu_privacy_policy"
        android:textSize="18sp"
        android:textColor="#333333"
        android:gravity="center"
        android:textAlignment="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/menu_item_user_agreement"
        android:layout_width="match_parent"
        android:layout_height="39dp"
        android:text="@string/mix_menu_user_agreement"
        android:textSize="18sp"
        android:textColor="#333333"
        android:gravity="center"
        android:textAlignment="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/menu_item_help"
        android:layout_width="match_parent"
        android:layout_height="39dp"
        android:text="@string/mix_menu_help"
        android:textSize="18sp"
        android:textColor="#333333"
        android:gravity="center"
        android:textAlignment="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/menu_item_language"
        android:layout_width="match_parent"
        android:layout_height="39dp"
        android:text="@string/mix_menu_language"
        android:textSize="18sp"
        android:textColor="#333333"
        android:gravity="center"
        android:textAlignment="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="?attr/selectableItemBackground" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E0E0E0" />

    <TextView
        android:id="@+id/menu_item_version"
        android:layout_width="match_parent"
        android:layout_height="39dp"
        android:textSize="18sp"
        android:textColor="#333333"
        android:gravity="center"
        android:textAlignment="center"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

</LinearLayout>
