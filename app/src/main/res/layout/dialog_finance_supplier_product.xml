<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp">

        <TextView
            style="@style/FarmFieldLabel"
            android:text="@string/finance_spec" />

        <EditText
            android:id="@+id/et_spec"
            style="@style/FarmFieldInput"
            android:inputType="text"
            android:maxLines="1" />

        <TextView
            style="@style/FarmFieldLabel"
            android:text="@string/finance_purchase_pick_category" />

        <Spinner
            android:id="@+id/sp_category"
            android:layout_width="match_parent"
            android:layout_height="48dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FarmFieldLabel"
                    android:text="@string/finance_purchase_base_unit" />

                <Spinner
                    android:id="@+id/sp_unit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FarmFieldLabel"
                    android:text="@string/finance_purchase_pack_unit" />

                <Spinner
                    android:id="@+id/sp_pack_unit"
                    android:layout_width="match_parent"
                    android:layout_height="48dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FarmFieldLabel"
                    android:text="@string/finance_purchase_pack_qty" />

                <EditText
                    android:id="@+id/et_pack_qty"
                    style="@style/FarmFieldInput"
                    android:inputType="numberDecimal" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/FarmFieldLabel"
                    android:text="@string/finance_purchase_base_price" />

                <EditText
                    android:id="@+id/et_price"
                    style="@style/FarmFieldInput"
                    android:inputType="numberDecimal" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_pack_spec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#2196F3"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
